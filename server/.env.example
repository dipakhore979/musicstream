# --- Server ---
NODE_ENV=development
PORT=5000
# Frontend origin(s) allowed by CORS and the CSRF origin check. Comma-separate several. No trailing slash.
CLIENT_URL=http://localhost:5173

# --- MongoDB Atlas ---
# Atlas > Connect > Drivers. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/musicstream?retryWrites=true&w=majority

# --- Auth (used from Phase 2) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- Cloudinary (used from Phase 3) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Production only ---
# Number of reverse proxies in front of the API. 1 = Render/Railway only.
# Use 2 when the frontend forwards /api through Vercel (recommended, see README) so rate limits
# see each visitor's real IP instead of Vercel's.
TRUST_PROXY_HOPS=1

# --- Email (OTP codes for signup verification and password reset) ---
# console = print emails in this terminal (fine for development, refused in production)
# brevo | resend = send through their HTTP API (works on Render's free plan)
# smtp = classic SMTP such as Gmail (needs: npm install nodemailer --prefix server)
EMAIL_PROVIDER=brevo
EMAIL_FROM=MusicStream <dipakhore979@gmail.com>
BREVO_API_KEY=your_brevo_api_key_here
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
