{
  "id": "/",
  "name": "MusicStream",
  "short_name": "MusicStream",
  "description": "Stream music, build playlists and save your favourite songs.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["music", "entertainment"],
  "icons": [
