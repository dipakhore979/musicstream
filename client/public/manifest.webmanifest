    { "name": "Liked Songs", "url": "/liked", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Your Library", "url": "/library", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
